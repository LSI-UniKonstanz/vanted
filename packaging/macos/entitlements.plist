<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Exceptions the JVM needs under the hardened runtime:

  allow-jit                         JIT compiler generates code at run time
  allow-unsigned-executable-memory  the same for older JVMs such as Java 8
  disable-library-validation        load JNI libraries signed by other teams
                                    (VANTED add-ons, system JNI)

  Corretto's own entitlements (dyld environment variables, debugger, audio
  input) are not needed and deliberately left out.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
